\newcommand{\SGAcover}[4]{%
  \clearpage\hypersetup{pageanchor=false}\thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[SGAnavy] (current page.south west) rectangle (current page.north east);
    \fill[SGAgold] ([xshift=20mm]current page.north west) rectangle ++(1.1mm,-25mm);
    \node[anchor=north west,text=SGApaper,font=\sffamily\small,align=left] at ([xshift=26mm,yshift=-19mm]current page.north west) {BOIS MARIE\\代数几何讨论班};
    \node[anchor=north west,text=SGAgold,font=\sffamily\fontsize{51}{55}\selectfont] at ([xshift=23mm,yshift=-46mm]current page.north west) {#1};
    \node[anchor=north west,text=white,text width=145mm,align=left,font=\sffamily\bfseries\fontsize{25}{37}\selectfont] at ([xshift=25mm,yshift=-77mm]current page.north west) {#2};
    \node[anchor=north west,text=SGApaper!80,text width=137mm,align=left,font=\itshape\small] at ([xshift=26mm,yshift=-123mm]current page.north west) {#3};
    \begin{scope}[shift={([xshift=95mm,yshift=63mm]current page.south west)},x=1mm,y=1mm]
      \draw[SGApaper!24,line width=.5pt] (-64,-14) .. controls (-22,-30) and (20,-2) .. (65,-15);
      \foreach \x/\y in {-48/-17,-17/-17,17/-12,48/-12}{
        \draw[SGApaper!24,line width=.45pt] (\x,\y) -- +(0,43);
        \draw[SGAgold!75,line width=.65pt] (\x,\y+34) ellipse (9 and 4);
        \fill[SGAgold] (\x,\y) circle (.8);
        \fill[SGApaper] (\x,\y+34) circle (.75);
      }
      \draw[SGAgold!70,line width=.6pt] (-48,17) .. controls (-32,5) and (-22,37) .. (-17,17) .. controls (0,-1) and (10,35) .. (17,22) .. controls (27,8) and (39,34) .. (48,22);
      \draw[SGApaper!35,-{Stealth[length=2mm]},line width=.5pt] (-3,8) -- (-3,-15);
    \end{scope}
    \draw[SGAgold!60,line width=.45pt] ([xshift=26mm,yshift=28mm]current page.south west) -- ([xshift=-26mm,yshift=28mm]current page.south east);
    \node[anchor=south west,text=SGApaper,text width=138mm,font=\small,align=left] at ([xshift=26mm,yshift=13mm]current page.south west) {#4\ifSGADraft\hfill 阶段译稿\else\hfill 中文译本\fi};
  \end{tikzpicture}\null\clearpage\hypersetup{pageanchor=true}%
}
\newcommand{\SGAchapter}[3]{%
  \setcounter{footnote}{0}%
  \chapter*{\texorpdfstring{\textcolor{SGAgold}{\large 第 #1 讲}\\[.35em]#2}{第 #1 讲\quad #2}}%
  \addcontentsline{toc}{chapter}{\texorpdfstring{第 #1 讲\quad #2}{第 #1 讲 #2}}%
  \markboth{\SGAseriesname}{第 #1 讲\quad #2}%
  {\noindent\color{SGAteal}\itshape #3\par}\vspace{1em}%
}
\newcommand{\SGAsection}[2]{\section*{#1.\quad #2}\addcontentsline{toc}{section}{\texorpdfstring{#1.\quad #2}{#1. #2}}}
\newcommand{\SGAsubsection}[2]{\subsection*{#1.\quad #2}\addcontentsline{toc}{subsection}{\texorpdfstring{#1.\quad #2}{#1. #2}}}
\newcommand{\SourcePage}[1]{\SGAsourceanchor{#1}\marginpar{\raggedright\sffamily\fontsize{6.5}{8}\selectfont\color{SGAteal!75}原 PDF\,#1}}
\newenvironment{SGAresult}[2]{\par\addvspace{.65em}\noindent\textbf{#1\ifstrempty{#2}{}{ #2}。}\ignorespaces}{\par\addvspace{.4em}}
\newcommand{\SGAunclear}[1]{\ifSGADraft\else\PackageError{sga-zh}{Unresolved source passage in complete edition}{Resolve the passage or use a clearly labelled draft.}\fi\textcolor{red!70!black}{〔待辨识：#1〕}}
\newcommand{\SGAsourcegap}[1]{\textcolor{SGAgold!65!black}{〔原文缺失〕}}
\newcommand{\SGAfrontchapter}[1]{\chapter*{#1}\addcontentsline{toc}{chapter}{#1}\markboth{\SGAseriesname}{#1}}
\newcommand{\SGAdraftnotice}[1]{\SGAfrontchapter{译稿进度说明}本文件为阶段译稿。#1\par 全套目标为十二个分册及一个总本；未收入的原文尚待翻译。原 PDF 页码在正文外侧标出。}
\newcounter{SGAocc}
\ExplSyntaxOn
\tl_new:N \g_sga_volume_tl
\prop_new:N \g_sga_zh_prop
\prop_new:N \g_sga_en_prop
\prop_new:N \g_sga_fr_prop
\prop_new:N \g_sga_use_prop
\seq_new:N \g_sga_use_seq
\prop_new:N \g_sga_source_prop
\NewDocumentCommand{\SGAsourceanchor}{m}{
  \tl_set:Nx \l_tmpa_tl {sga-source-\g_sga_volume_tl-#1}
  \exp_args:NNV \prop_if_in:NnF \g_sga_source_prop \l_tmpa_tl {
    \hypertarget{\l_tmpa_tl}{}
    \exp_args:NNV \prop_gput:Nnn \g_sga_source_prop \l_tmpa_tl {seen}
  }
}
\NewDocumentCommand{\SGAsourceRef}{m}{\hyperlink{sga-source-\g_sga_volume_tl-#1}{原~PDF~#1}}
\NewDocumentCommand{\DeclareSGATerm}{mmmm}{
  \prop_if_in:NnF \g_sga_zh_prop {#1}{
    \prop_gput:Nnn \g_sga_zh_prop {#1}{#2}
    \prop_gput:Nnn \g_sga_en_prop {#1}{#3}
    \prop_gput:Nnn \g_sga_fr_prop {#1}{#4}
  }
}
\NewDocumentCommand{\BeginSGAVolume}{mmm}{
  \tl_gset:Nn \g_sga_volume_tl {#1}
  \prop_gclear:N \g_sga_use_prop
  \seq_gclear:N \g_sga_use_seq
  \renewcommand{\SGAseriesname}{#2}
  \renewcommand{\SGAsourcename}{#3}
  \ifSGATotal\part{#2}\fi
  \markboth{#2}{#2}
}
\NewDocumentCommand{\Term}{mm}{
  \stepcounter{SGAocc}
  \tl_set:Nx \l_tmpa_tl {sga-occ-\g_sga_volume_tl-\arabic{SGAocc}}
  \hypertarget{\l_tmpa_tl}{}\label{\l_tmpa_tl}
  \seq_if_exist:cF {g_sga_occ_\g_sga_volume_tl _#1_seq}{
    \seq_new:c {g_sga_occ_\g_sga_volume_tl _#1_seq}
    \seq_gput_right:Nn \g_sga_use_seq {#1}
  }
  \seq_gput_right:cx {g_sga_occ_\g_sga_volume_tl _#1_seq}{\l_tmpa_tl}
  \hyperlink{sga-term-\g_sga_volume_tl-#1}{\textcolor{SGAink}{\mbox{#2}}}
  \peek_meaning:NT \Term {\allowbreak}
}
\cs_new_protected:Npn \sga_glossary_row:n #1 {
  \par\addvspace{.85em}\noindent
  \begin{tabular}{@{}>{\raggedright\arraybackslash}p{.25\textwidth}>{\raggedright\arraybackslash}p{.34\textwidth}>{\raggedright\arraybackslash}p{.34\textwidth}@{}}
  \hypertarget{sga-term-\g_sga_volume_tl-#1}{}\bfseries
  \prop_if_in:NnTF \g_sga_zh_prop {#1}
    {\prop_item:Nn\g_sga_zh_prop{#1}}
    {\textcolor{red}{#1}}
  &\prop_item:Nn\g_sga_en_prop{#1}
  &\prop_item:Nn\g_sga_fr_prop{#1}
  \tabularnewline\end{tabular}\par\nobreak
  {\footnotesize\noindent\textcolor{SGAteal}{正文位置：}
    \seq_map_inline:cn {g_sga_occ_\g_sga_volume_tl _#1_seq}{\hyperlink{##1}{\pageref*{##1}}\hspace{.3em}}
    \par}
}
\NewDocumentCommand{\PrintSGAGlossary}{}{
  \SGAfrontchapter{中—英—法技术性名词对照表}
  {\small 点击正文术语可到达本表；“正文页码”中的每个链接分别返回一个出现位置。同页多次出现时，页码重复列出。\par}
  \begingroup\small\setlength{\tabcolsep}{3pt}\setlength{\parindent}{0pt}
  \noindent\begin{tabular}{@{}p{.25\textwidth}p{.34\textwidth}p{.34\textwidth}@{}}
  \toprule\textbf{中文}&\textbf{English}&\textbf{Français}\\\bottomrule
  \end{tabular}\par
  \seq_map_function:NN \g_sga_use_seq \sga_glossary_row:n
  \endgroup
}
\ExplSyntaxOff
